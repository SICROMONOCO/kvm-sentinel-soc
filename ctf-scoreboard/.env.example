# =============================================================================
# CTF Scoreboard — environment template
#
# Copy to .env and fill in real values before starting the stack:
#     cp .env.example .env
#
# .env is gitignored and excluded from the Docker build context by
# .dockerignore. Never commit real flags or a real admin token.
# =============================================================================

# --- Host port ---------------------------------------------------------------
# Only this host port is published. The container always listens on 8080.
# Change it if something else already owns 8080 on the host.
SCOREBOARD_PORT=8080

# --- Challenge flags ---------------------------------------------------------
# WARNING: These are real scoring secrets. Do not commit filled-in values, do
# not post them in chat, and do not bake them into an image.
#
# Enter the exact fragment values configured for the lab. Leave any value
# empty to disable that stage. Deployment-specific instructions are kept
# outside the public repository.
FLAG_PART1=
FLAG_PART2=
FLAG_PART3=

# --- Admin reset token -------------------------------------------------------
# Required to use the /admin reset page. Use a long random value, for example:
#     openssl rand -hex 32
# Leave empty to disable the admin page entirely.
ADMIN_TOKEN=

# --- Session clock -----------------------------------------------------------
# Optional ISO-8601 timestamp used as the start of the scored session. Elapsed
# time is measured from this instant to a team's latest solve. UTC is safest:
#     SESSION_START=2026-11-09T09:00:00Z
# Leave empty to use the time the first solve is recorded.
SESSION_START=

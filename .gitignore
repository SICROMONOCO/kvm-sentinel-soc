# ============================================================
# KVM-Sentinel-SOC — .gitignore
# ============================================================

# --- Lab runtime artefacts (generated by deploy-lab.sh) -------
.env
*.qcow2
*.img
*.iso
*.part
*.raw

host/provisioning/images/
host/provisioning/seeds/
host/provisioning/build/
host/controller/state/
vm1-honeypot/logs/
vm1-honeypot/.env
vm2-soc/state/
vm2-soc/.env

# dashboard runtime: per-component logs, pidfiles, shell transcripts
logs/

# Incident reports are generated during a session; only the directory marker
# is versioned
vm2-soc/reports/*.md
vm2-soc/reports/*.json
vm2-soc/reports/*.tmp
!vm2-soc/reports/.gitkeep

# --- Python ---------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
build/
dist/
venv/
.venv/
env/
.env.local
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# --- Docker ---------------------------------------------------
.docker/

# --- Editors / OS --------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace
*.iml

# --- Agent/tooling scratch (not part of the deliverable) -------
.omo/
.claude/
*.tmp

# --- Nix ------------------------------------------------------
result
result-*
.direnv/

# --- Secrets & credentials ------------------------------------
*.pem
*.key
*.crt
*.p12
id_rsa*
id_ed25519*
*.token
secrets/
credentials/

# --- Logs & dumps ---------------------------------------------
*.log
*.dump
*.core

# --- Temporary files ------------------------------------------
/tmp/
*.bak
*.orig
*.rej

# Local operator notes contain live lab credentials.
WORKSETUP.md

# --- Large binary files (keep repo lean) ----------------------
*.pdf
*.zip
*.tar.gz
*.tar.xz

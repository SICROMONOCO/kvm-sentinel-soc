# =============================================================================
# KVM-Sentinel-SOC — environment template
# Copy to .env (gitignored). Real environment variables win over this file.
#   cp .env.example .env
# =============================================================================

# --- controller (vm-soc -> host webhook) ------------------------------------
# Shared secret expected in the X-Sentinel-Token header. Empty disables auth
# (acceptable inside the isolated lab only).
SENTINEL_TOKEN=

# --- AI model ----------------------------------------------------------------
# Smallest practical model for 4 vCPU / 4 GiB. Used by ollama-init and agents.
OLLAMA_MODEL=qwen2.5:0.5b

# --- dashboard: tmux session and logs ---------------------------------------
DASH_SESSION=kvm-sentinel
# DASH_LOG_DIR=/absolute/path/to/logs/tmux-dashboard

# --- dashboard: host controller ---------------------------------------------
DASH_CTRL_HOST=192.168.122.1
DASH_CTRL_PORT=5000
# DASH_CTRL_AUDIT=/absolute/path/to/incidents.jsonl

# --- dashboard: SSH ----------------------------------------------------------
# Prefer a key path here when the dashboard runs from a non-login shell or sudo.
# DASH_SSH_KEY=/home/you/.ssh/id_ed25519

# --- dashboard: vm-honeypot (management SSH, not the trap) -------------------
DASH_VM1_HOST=10.10.0.10
DASH_VM1_PORT=22
DASH_VM1_USER=soc
# Documented lab password. Prefer SSH keys; set this only if sshpass is
# installed and key auth is not available.
# DASH_VM1_PASSWORD=sentinel
DASH_VM1_COMPOSE_DIR=/opt/honeypot

# --- dashboard: vm-soc -------------------------------------------------------
DASH_VM2_HOST=192.168.122.20
DASH_VM2_PORT=22
DASH_VM2_USER=soc
# DASH_VM2_PASSWORD=sentinel
DASH_VM2_COMPOSE_DIR=/opt/soc

# --- dashboard: service endpoints (host-reachable) ---------------------------
DASH_LOKI_URL=http://192.168.122.20:3100
DASH_GRAFANA_URL=http://192.168.122.20:3000
DASH_OLLAMA_URL=http://192.168.122.20:11434
DASH_TRAP_ADDR=10.10.0.10:2222

# --- dashboard: startup timeouts (seconds) ----------------------------------
# Guest boot / HTTP readiness window.
DASH_READY_TIMEOUT=180
# `docker compose up -d` budget; first run pulls images over the guest's link.
DASH_STACK_TIMEOUT=900

# --- CTF (optional) ----------------------------------------------------------
# Empty disables that stage. See the lab documentation for deployment notes.
FLAG_PART1=
FLAG_PART2=
FLAG_PART3=
